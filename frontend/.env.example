# Copy to .env.local for local overrides, or set in your hosting
# provider's dashboard (e.g. Vercel > Project > Settings > Environment
# Variables) for production builds.
#
# Leave unset for local dev -- Vite's dev server proxies /api to
# http://localhost:8000 (see vite.config.ts) without needing this.
#
# Required in production, where frontend and backend are on different
# origins with nothing to proxy through:
VITE_API_BASE_URL=https://your-backend.onrender.com
